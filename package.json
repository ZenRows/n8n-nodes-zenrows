{
	"name": "@zenrows/n8n-nodes-zenrows",
	"version": "0.1.0",
	"description": "n8n community node for Zenrows. Scrape pages with anti-bot bypass, JS rendering and proxy rotation, pull structured data out of them, crawl a site from one URL, and run the same work as a batch job.",
	"license": "MIT",
	"homepage": "https://github.com/ZenRows/n8n-nodes-zenrows",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"zenrows",
		"web-scraping",
		"scraper",
		"crawler",
		"anti-bot",
		"proxy"
	],
	"author": {
		"name": "Zenrows",
		"email": "support@zenrows.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ZenRows/n8n-nodes-zenrows.git"
	},
	"bugs": {
		"url": "https://github.com/ZenRows/n8n-nodes-zenrows/issues"
	},
	"engines": {
		"node": ">=20.19"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"prepublishOnly": "n8n-node prerelease",
		"release": "n8n-node release",
		"test": "node --test test/*.test.js"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ZenrowsApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Zenrows/Zenrows.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.54.4",
		"prettier": "3.8.3",
		"release-it": "^21.1.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
